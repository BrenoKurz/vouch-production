{
  "expo": {
    "name": "Vouch",
    "slug": "vouch-production",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/vouch-icon.png",
    "scheme": "vouch",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/vouch-icon.png",
      "bundleIdentifier": "com.vouchdating.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.vouchdating.app",
      "adaptiveIcon": {
        "backgroundColor": "#713F36",
        "foregroundImage": "./assets/images/vouch-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/vouch-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3ED",
          "image": "./assets/images/vouch-splash.png",
          "imageWidth": 112
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vouch to access a photo you choose for your private member profile.",
          "cameraPermission": "Allow Vouch to use your camera when you choose to take a private profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Vouch to record a private voice reflection only when you choose voice-assisted intake.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#713F36",
          "defaultChannel": "vouch-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "894a98f0-d04d-421c-a8a6-e0a27cb910fb"
      }
    },
    "owner": "brenorosada"
  }
}
